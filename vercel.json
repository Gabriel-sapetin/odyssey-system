{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/os-odyssey/frontend/html/index.html", "destination": "/", "statusCode": 302 },
    { "source": "/os-odyssey/frontend/html/", "destination": "/", "statusCode": 302 }
  ],
  "rewrites": [
    { "source": "/css/:match*", "destination": "/os-odyssey/frontend/css/:match*" },
    { "source": "/js/:match*", "destination": "/os-odyssey/frontend/js/:match*" },
    { "source": "/assets/:match*", "destination": "/os-odyssey/assets/:match*" },
    { "source": "/manifest.json", "destination": "/os-odyssey/manifest.json" },
    { "source": "/sw.js", "destination": "/os-odyssey/sw.js" },
    { "source": "/", "destination": "/os-odyssey/frontend/html/index.html" },
    { "source": "/:page.html", "destination": "/os-odyssey/frontend/html/:page.html" },
    { "source": "/:page", "destination": "/os-odyssey/frontend/html/:page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), autoplay=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
