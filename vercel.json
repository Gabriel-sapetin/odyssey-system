{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/$1",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/%241",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/frontend/css/:path*",
      "destination": "/css/:path*",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/frontend/js/:path*",
      "destination": "/js/:path*",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/assets/:path*",
      "destination": "/assets/:path*",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/sw.js",
      "destination": "/sw.js",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/manifest.json",
      "destination": "/manifest.json",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/frontend/html/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/frontend/html/index",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/frontend/html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/frontend/html/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/frontend/html/:page.html",
      "destination": "/:page",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/frontend/html/:page",
      "destination": "/:page",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/frontend",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/frontend/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/frontend/css/:path*",
      "destination": "/css/:path*",
      "statusCode": 301
    },
    {
      "source": "/frontend/js/:path*",
      "destination": "/js/:path*",
      "statusCode": 301
    },
    {
      "source": "/frontend/html/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/frontend/html/index",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/frontend/html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/frontend/html/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/frontend/html/:page.html",
      "destination": "/:page",
      "statusCode": 301
    },
    {
      "source": "/frontend/html/:page",
      "destination": "/:page",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/os-odyssey/:path*",
      "destination": "/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), autoplay=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
