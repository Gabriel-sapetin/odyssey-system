# ─── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Server ─────────────────────────────────────────────
PORT=4000
ENV=development

# ─── CORS ───────────────────────────────────────────────
# Add your production Vercel URL here (e.g. https://your-app.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://your-app.vercel.app

# ─── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_AUTH=10/minute

# ─── Thread Pool ────────────────────────────────────────
WORKER_THREADS=4

# ─── Cloudflare Turnstile (bot protection) ──────────────
# Get your secret key from: https://dash.cloudflare.com → Turnstile
# Leave empty to skip verification in development
TURNSTILE_SECRET_KEY=
